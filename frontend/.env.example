# Optional. Only needed if you want to access NoteWise from your phone or
# another device on the same Wi-Fi network. Set this to your machine's LAN
# IP address (find it with `ipconfig` on Windows or `ifconfig`/`ip addr` on
# macOS/Linux). Leave unset to use http://localhost:5000/api (fine when
# you're only using NoteWise from the same machine that's running it).
# VITE_API_BASE_URL=http://192.168.1.23:5000/api
